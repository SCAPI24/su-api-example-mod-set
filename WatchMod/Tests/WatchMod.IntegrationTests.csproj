<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <WatchAssemblyPath Condition="'$(WatchAssemblyPath)' == ''">$(MSBuildThisFileDirectory)..\bin\Release\net10.0\WatchMod.dll</WatchAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Engine" Version="[0.2.0.0]" />
    <PackageReference Include="EntitySystem" Version="[0.2.0.0]" />
    <PackageReference Include="Survivalcraft" Version="[0.2.0.0]" />
    <Reference Include="WatchMod"><HintPath>$(WatchAssemblyPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="CheckExistingAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(WatchAssemblyPath)')" Text="Build the migrated WatchMod Release DLL first or specify WatchAssemblyPath." />
  </Target>
</Project>
