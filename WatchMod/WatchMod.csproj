<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- 引擎依赖改为从 CNB NuGet 制品库引用，不再 ProjectReference 引擎源码。
       源为全局 NuGet 源 cnb-nuget。包版本需与 ModInfo.xml 的 APIVersion 对应。 -->
  <ItemGroup>
    <PackageReference Include="Engine" Version="0.1.6.0" />
    <PackageReference Include="EntitySystem" Version="0.1.6.0" />
    <PackageReference Include="Survivalcraft" Version="0.1.6.0" />
  </ItemGroup>

  <!-- Obfuscar 需要引擎 DLL 与 Mod DLL 同时位于 bin\<Config>\net8.0。
       PackageReference 默认不把依赖包复制到库工程的输出目录，故显式开启。 -->
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Obfuscar" Version="2.2.49">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="&quot;$(Obfuscar)&quot; Obfuscar.xml" />
  </Target>
</Project>
