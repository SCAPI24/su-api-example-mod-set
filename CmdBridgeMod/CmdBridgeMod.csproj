<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CmdBridgeMod</AssemblyName>
    <RootNamespace>CmdBridgeMod</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CM-2：共控合并需要读**真实**设备状态（OpenTK 的全局键盘/鼠标快照）。
      OpenTK 改为**纯反射**访问（Server/OpenTkInput.cs）：Android 端不部署 OpenTK，
      任何以它的类型声明的字段/参数都会让 Mod 在加载时失败（实测），因此这里不再
      引用该程序集，桌面端行为不变。
    -->
    <PackageReference Include="Engine" Version="[0.2.1.0]" />
    <PackageReference Include="EntitySystem" Version="[0.2.1.0]" />
    <PackageReference Include="Survivalcraft" Version="[0.2.1.0]" />
    <PackageReference Include="SuAPICore" Version="[0.2.1.0]" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Obfuscar" Version="2.2.49">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="ObfuscateMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ObfuscarConfig>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)Obfuscar.xml</_ObfuscarConfig>
      <_ObfuscarDependencies>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)ObfuscarDependencies</_ObfuscarDependencies>
      <_ObfuscarOutput>$(TargetDir)Obfuscar</_ObfuscarOutput>
    </PropertyGroup>
    <!-- Source: ResolveAssemblyReferences:ReferencePath — use resolved package assets, never a cache-version path. -->
    <ItemGroup>
      <_ObfuscarDependency Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' != ''" />
    </ItemGroup>
    <RemoveDir Directories="$(_ObfuscarDependencies);$(_ObfuscarOutput)" />
    <MakeDir Directories="$(_ObfuscarDependencies)" />
    <Copy SourceFiles="@(_ObfuscarDependency)" DestinationFolder="$(_ObfuscarDependencies)" />
    <Copy SourceFiles="Obfuscar.xml" DestinationFiles="$(_ObfuscarConfig)" />
    <XmlPoke XmlInputPath="$(_ObfuscarConfig)" Query="/Obfuscator/Var[@name='InPath']/@value" Value="$(TargetDir)" />
    <XmlPoke XmlInputPath="$(_ObfuscarConfig)" Query="/Obfuscator/Var[@name='OutPath']/@value" Value="$(_ObfuscarOutput)" />
    <XmlPoke XmlInputPath="$(_ObfuscarConfig)" Query="/Obfuscator/AssemblySearchPath/@path" Value="$(_ObfuscarDependencies)" />
    <Exec Command="&quot;$(Obfuscar)&quot; &quot;$(_ObfuscarConfig)&quot;" />
    <Error Condition="!Exists('$(_ObfuscarOutput)\$(TargetFileName)')" Text="Release obfuscation did not produce $(TargetFileName)." />
  </Target>
</Project>
