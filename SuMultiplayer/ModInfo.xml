      <ContentRoot>Content/</ContentRoot>
    </Asset>
  </ModInfo>
  <Dependencies>
    <Dependency>
      <ModInfo>
        <Identifier>Google.Protobuf</Identifier>
        <IsMergeLib>true</IsMergeLib>
      </ModInfo>
    </Dependency>
  </Dependencies>
</Mod>
