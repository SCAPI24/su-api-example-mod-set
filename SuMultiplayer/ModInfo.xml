<Mod>
  <ModInfo>
    <Identifier>SuMultiplayer</Identifier>
    <LocalizedName>
      <Text lang="en_US">SuMultiplayer</Text>
      <Text lang="zh_CN">联机模组</Text>
    </LocalizedName>
