<Project Sdk="Microsoft.NET.Sdk">
  <!--
    lmsample：打印一份真实的 /state JSON 样本（用工具自己的 BuildStateJson + 合成快照），
    供人工核对 / 报告引用。它不是通过/失败型套件，退出码 0 即成功。

    路径全部相对工程文件目录解析（与 LmVerify 相同的生产源码集合）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LmSample</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>LmSample.Sample</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Sample.cs" />
    <Compile Include="..\..\..\Tools\LiveMap\Program.cs" />
    <Compile Include="..\..\..\Terrain\*.cs" />
    <Compile Include="..\..\..\Net\*.cs"
             Exclude="..\..\..\Net\TransportPort.cs;..\..\..\Net\PlayerPositionNet.cs" />
  </ItemGroup>
</Project>
