<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SuEventBus</AssemblyName>
    <RootNamespace>SuEventBus</RootNamespace>
    <!-- 中间件：与 ScMultiplayer/Channel 一样走 cnb-nuget 制品库，避免工程引用与包引用混用 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Engine" Version="0.1.7.0" />
    <PackageReference Include="EntitySystem" Version="0.1.7.0" />
    <PackageReference Include="Survivalcraft" Version="0.1.7.0" />
  </ItemGroup>
</Project>
