<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>HeadlessRenderingMod</AssemblyName>
    <RootNamespace>HeadlessRenderingMod</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source: doc/mod-nuget-compile-guide.md:NuGet dependencies — do not build or bundle the game. -->
    <PackageReference Include="Engine" Version="[0.2.1.0]" />
    <PackageReference Include="EntitySystem" Version="[0.2.1.0]" />
    <PackageReference Include="Survivalcraft" Version="[0.2.1.0]" />
    <PackageReference Include="SuAPICore" Version="[0.2.1.0]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Native\libGLESv2.dll"
                      LogicalName="HeadlessRenderingMod.Native.libGLESv2.dll" />
    <EmbeddedResource Include="Native\opengl32-headless.dll"
                      LogicalName="HeadlessRenderingMod.Native.opengl32-headless.dll" />

    <!-- Linux 版空壳库（no-GPU）：源码在 Native/null_*.c，编译方式见 Native/linux-x64/README.md。
         逻辑名用 HeadlessRenderingMod.Native.linux.*，与 Windows 的 .dll 分开，互不干扰。 -->
    <EmbeddedResource Include="Native\linux-x64\libgbm-headless.so"
                      LogicalName="HeadlessRenderingMod.Native.linux.libgbm-headless.so" />
    <EmbeddedResource Include="Native\linux-x64\libdrm-headless.so"
                      LogicalName="HeadlessRenderingMod.Native.linux.libdrm-headless.so" />
    <EmbeddedResource Include="Native\linux-x64\libEGL-headless.so"
                      LogicalName="HeadlessRenderingMod.Native.linux.libEGL-headless.so" />
    <EmbeddedResource Include="Native\linux-x64\libGLESv2-headless.so"
                      LogicalName="HeadlessRenderingMod.Native.linux.libGLESv2-headless.so" />
    <EmbeddedResource Include="Native\linux-x64\libinput-headless.so"
                      LogicalName="HeadlessRenderingMod.Native.linux.libinput-headless.so" />
    <EmbeddedResource Include="Native\linux-x64\libc-headless.so"
                      LogicalName="HeadlessRenderingMod.Native.linux.libc-headless.so" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Obfuscar" Version="2.2.49">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="ObfuscateMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ObfuscarConfig>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)Obfuscar.xml</_ObfuscarConfig>
      <_ObfuscarDependencies>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)ObfuscarDependencies</_ObfuscarDependencies>
      <_ObfuscarOutput>$(TargetDir)Obfuscar</_ObfuscarOutput>
    </PropertyGroup>
    <!-- Source: ResolveAssemblyReferences:ReferencePath — resolve dependencies from the actual NuGet assets. -->
    <ItemGroup>
      <_ObfuscarDependency Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' != ''" />
    </ItemGroup>
    <RemoveDir Directories="$(_ObfuscarDependencies);$(_ObfuscarOutput)" />
    <MakeDir Directories="$(_ObfuscarDependencies)" />
    <Copy SourceFiles="@(_ObfuscarDependency)" DestinationFolder="$(_ObfuscarDependencies)" />
    <Copy SourceFiles="Obfuscar.xml" DestinationFiles="$(_ObfuscarConfig)" />
    <XmlPoke XmlInputPath="$(_ObfuscarConfig)"
             Query="/Obfuscator/Var[@name='InPath']/@value"
             Value="$(TargetDir)" />
    <XmlPoke XmlInputPath="$(_ObfuscarConfig)"
             Query="/Obfuscator/Var[@name='OutPath']/@value"
             Value="$(_ObfuscarOutput)" />
    <XmlPoke XmlInputPath="$(_ObfuscarConfig)"
             Query="/Obfuscator/AssemblySearchPath/@path"
             Value="$(_ObfuscarDependencies)" />
    <Exec Command="&quot;$(Obfuscar)&quot; &quot;$(_ObfuscarConfig)&quot;" />
    <Error Condition="!Exists('$(_ObfuscarOutput)\$(TargetFileName)')" Text="Release obfuscation did not produce $(TargetFileName)." />
  </Target>
</Project>
